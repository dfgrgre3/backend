# ==========================================
# Docker Compose Environment Variables
# ==========================================
# Copy this file to .env.docker and adjust values if needed:
#   cp .env.docker.example .env.docker
#
# Docker Compose reads .env.docker automatically when you run:
#   docker compose --env-file .env.docker up -d
#
# These are ONLY for the infrastructure services (Postgres, Redis, MinIO, Mailpit).
# The application's own settings live in .env

# ==========================================
# PostgreSQL
# ==========================================
POSTGRES_USER=thanawy
# REQUIRED: Set a strong password (no default value)
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=thanawy
POSTGRES_PORT=5432

# ==========================================
# Redis
# ==========================================
REDIS_PORT=6379

# ==========================================
# MinIO (S3-compatible storage)
# ==========================================
MINIO_ROOT_USER=minioadmin
# REQUIRED: Set a strong password (no default value)
MINIO_ROOT_PASSWORD=change_me_strong_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=thanawy

# ==========================================
# Mailpit (Email testing) - Dev Profile
# ==========================================
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ==========================================
# Backend
# ==========================================
BACKEND_PORT=8082

# ==========================================
# Frontend
# ==========================================
FRONTEND_PORT=3000
*.exe
*.exe~
*.dll

# Unix/Linux/macOS binaries/libraries
*.so
*.dylib
bin/
.gocache/

# Root-level built binaries (Unix/Linux/macOS)
/api
/backend
/clear-rate-limits
/main
/targeted_migrate
/thanawy-backend

# ==========================================
# Environment & Configuration Files
# ==========================================
.env
.env.local
.env.*
!.env.example
!.env.docker.example

# Also ensure any .env* in subdirectories is ignored
**/.env
**/.env.local
**/.env.*
!**/.env.example
!**/.env.docker.example


# Git files
.git
.gitignore
.gitattributes

# Documentation
docs
*.md
!README.md

# IDE and editor files
.idea
.vscode
*.swp
*.swo
*~

# Test files
*_test.go
*_test
test
tests
*_test.go
internal/*/*_test.go
internal/*/*/*_test.go
cmd/*/*_test.go

# Coverage files
coverage.out
coverage.html
*.cover

# Build artifacts
bin
dist
build
*.exe
*.dll
*.so
*.dylib

# Go modules
go.sum
go.mod

# Environment files with secrets
.env
.env.*
!.env.example
!.env.docker.example
.env.local
.env.development
.env.production

# Temporary files
tmp
temp
*.tmp
*.log

# Docker files (keep docker-compose for reference, but exclude Dockerfile if you want to build from outside)
Dockerfile*
docker-compose*.yml
!Dockerfile.example
!docker-compose.example.yml

# Scripts that shouldn't be in the image
scripts
!scripts/docker-entrypoint.sh

# Vercel config
vercel.json
.vercel

# README files (keep main one)
README*

# Travis, CircleCI, etc.
.travis.yml
.circleci
.github

# Local uploads (should use volumes)
uploads
*.upload

# Database files
*.sqlite
*.db

# Swagger gen files
swagger.json
swagger.yaml
